# --- Ambiente Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Dipendenze Node (Lighthouse) ---
node_modules/
package-lock.json

# --- Referti e artefatti generati ---
# I referti si rigenerano: e' il sito la fonte di verita', non il report.
report.html
report.json
referto.json
*.report.html

# --- Credenziali vere ---
# .env non e' letto da MARS (non c'e' python-dotenv): serve a tenere le
# chiavi a portata di mano per esportarle a mano. Ignorarlo comunque,
# perche' un "git add -A" distratto le pubblicherebbe per sempre.
.env
.env.*
!.env.example

# examples/audit_request.json contiene SEGNAPOSTO ed e' versionato.
# Per una richiesta con chiavi vere usare un file .local.json, che git
# ignora: cp examples/audit_request.json examples/mio.local.json
*.local.json

# --- Storico (dati, non codice) ---
# Due file distinti di due funzioni distinte, e sono dato dell'utente:
# mars_citations.py --history accoda al primo, l'audit differenziale di
# mars_history.py (STORICO_PREDEFINITO) al secondo.
storico.jsonl
.mars-history.jsonl

# --- Cache di strumenti ---
.pytest_cache/
.mars-cache/
.coverage
htmlcov/

# --- Editor e sistema ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Golden del referto: DATO DI TEST, non un artefatto rigenerabile ---
# La riga `referto.json` qui sopra non ha '/', quindi vale a OGNI livello
# e colpisce anche tests/golden/. Questi file sono la resa attesa dei
# renderer: si rigenerano con MARS_RIGENERA_GOLDEN=1 e si RIVEDONO nel
# diff, quindi vanno versionati.
!tests/golden/referto*
