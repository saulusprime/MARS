# MARS Beacon — variabili del container. Copiare in `.env` ACCANTO a
# questo file, che git ignora gia' (la regola `.env` in .gitignore non
# ha una barra e vale a ogni livello):
#
#     cp mars.env.example .env && chmod 600 .env
#
# Le chiavi stanno qui e non nell'immagine: un layer resta leggibile
# anche se un layer successivo cancella il file.

# --- Firma dei token dell'API ----------------------------------------
# Senza, mars_api genera una chiave effimera e lo dichiara: i token
# scadono a ogni riavvio del container. Generarne una:
#     python3 -c 'import secrets; print(secrets.token_hex(32))'
MARS_SECRET_KEY=

# --- Porta esposta sull'host (dentro il container resta 8000) --------
MARS_PORT_HOST=8000

# --- Area 10, giudizio LLM (l'unica che costa denaro) ----------------
# Senza, il giudizio non parte e il referto lo dichiara.
# In alternativa si passa un file con --credentials / il blocco
# `credentials` del corpo API: vedi examples/credentials.json.
ANTHROPIC_API_KEY=

# Gli altri giudici, se si usa --judge-models. Vanno passati per file:
# MARS non legge queste tre dall'ambiente.
#   openai_api_key, dashscope_api_key, moonshot_api_key

# --- Area 8, ZAP ------------------------------------------------------
# Il servizio `zap` di docker-compose.yml parte con
# api.disablekey=true, quindi la chiave non serve. Riempirla solo
# puntando a un daemon che la pretende.
ZAP_API_KEY=

# ZAP_PROXY lo imposta gia' docker-compose.yml (http://zap:8080).
# Sovrascriverlo qui solo per usare un daemon esterno, per esempio
# quello dell'host:  ZAP_PROXY=http://host.docker.internal:8080

# --- Area 5, embedding reali ------------------------------------------
# Serve solo per i modelli Hugging Face ad accesso limitato, e solo se
# l'immagine e' stata costruita con --build-arg MARS_EMBEDDINGS=on.
HF_TOKEN=
